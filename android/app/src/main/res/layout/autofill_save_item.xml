<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@android:color/white"
    android:gravity="center_vertical">

    <!-- Site Icon -->
    <ImageView
        android:id="@+id/iv_save_site_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/autofill_site_icon"
        android:src="@drawable/ic_default" />

    <!-- Text Content (Site Name, Username) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Site Name (title or appName) -->
        <TextView
            android:id="@+id/tv_save_site_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Site Name" />

        <!-- Username/Email -->
        <TextView
            android:id="@+id/tv_save_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="user@email.com" />

    </LinearLayout>

</LinearLayout>